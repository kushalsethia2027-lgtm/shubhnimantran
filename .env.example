# Guest & Travel Planner: public browser configuration, also set in Netlify.
# These are the same project, using its publishable or legacy anon key ONLY.
# Rebuild after changing VITE_* values. Never put a service-role key in VITE_*.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
