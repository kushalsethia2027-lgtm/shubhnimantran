SUPABASE_URL=https://ozvuruhglhyhuparvael.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPPORT_EMAIL=

# Optional AI script drafts (usage is requested explicitly by the host).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# Adapter configuration only: production generation/delivery stay disabled.
ELEVENLABS_API_KEY=
SHOTSTACK_API_KEY=
SHOTSTACK_ENV=stage
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
